<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>UriCredentialParser</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>UriCredentialParser</AssemblyName>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>ciu-parser</PackageId>
        <Title>Uri Credential Parser</Title>
        <Authors>Winner-Timothy Bolorunduro </Authors>
        <Description>A lightweight .NET library for parsing credentials from URLs and converting them into structured connection strings for PostgreSQL and MongoDB.</Description>
        <Copyright>©2024-2026, Bolorunduro Winner-Timothy. All Rights reserved.</Copyright>
        <PackageProjectUrl>https://github.com/bolorundurowb/UriCredentialParser</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/bolorundurowb/UriCredentialParser/blob/master/LICENSE</PackageLicenseUrl>
        <RepositoryUrl>https://github.com/bolorundurowb/UriCredentialParser</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>uri, url, credentials, connection-string, parser, postgres, npgsql, mongodb, redis, dotnet, csharp, authentication, parsing, utility</PackageTags>
        <Version>3.1.0</Version>
        <PackageReleaseNotes>See CHANGELOG.md for version history. Highlights: multi-host / replica-set parsing, TryParse, and ToRedisConnectionString.</PackageReleaseNotes>
        <AssemblyVersion>3.1.0</AssemblyVersion>
        <FileVersion>3.1.0</FileVersion>
        <NeutralLanguage>en-NG</NeutralLanguage>
        <!-- SourceLink / deterministic build setup for better NuGet debugging experience -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
